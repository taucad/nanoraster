{
  "$schema": "./node_modules/knip/schema.json",
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "src/**/*.test.ts",
        "src/index.test-d.ts",
        "tests/**/*.test.mjs",
        "*.config.ts",
        "*.test.ts"
      ],
      "ignore": ["src/cjs-error.d.cts", "src/wasm/**"],
      "ignoreBinaries": ["wasm-pack"],
      "ignoreDependencies": ["@nx/js"]
    },
    "docs-site": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "content/docs/props.ts",
        "mdx-components.tsx",
        "scripts/*.mjs",
        "source.config.ts",
        "*.config.{mjs,ts}"
      ],
      "ignore": ["public/demo/render_wasm.js"]
    }
  },
  "ignoreIssues": {
    "tests/browser/render.browser.test.mjs": ["unlisted", "unresolved"]
  }
}
