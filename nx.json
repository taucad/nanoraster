{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "runtime"],
    "runtime": [
      {
        "runtime": "node --version"
      },
      {
        "runtime": "pnpm --version"
      },
      {
        "runtime": "rustc --version"
      },
      {
        "runtime": "wasm-pack --version"
      }
    ]
  },
  "release": {
    "projects": ["nanoraster"],
    "projectsRelationship": "fixed",
    "version": {
      "specifierSource": "version-plans",
      "adjustSemverBumpsForZeroMajorVersion": false,
      "preVersionCommand": "pnpm nx run nanoraster:quality"
    },
    "versionPlans": {
      "ignorePatternsForPlanCheck": [
        "**/*.test.*",
        "AGENTS.md",
        "CONTRIBUTING.md",
        "MAINTAINER.md",
        "SECURITY.md",
        ".github/**",
        "docs-site/**",
        "tests/**",
        "bench/**"
      ]
    },
    "changelog": {
      "projectChangelogs": {
        "file": "CHANGELOG.md",
        "renderOptions": {
          "authors": true,
          "commitReferences": true,
          "versionTitleDate": true
        }
      }
    },
    "releaseTag": {
      "pattern": "v{version}"
    },
    "git": {
      "commit": false,
      "push": false,
      "stageChanges": false,
      "tag": false
    }
  },
  "analytics": false
}
