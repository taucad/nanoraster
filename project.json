{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "nanoraster",
  "root": ".",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:napi"],
      "options": {
        "command": "pnpm run build"
      }
    },
    "build:napi": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build:napi"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:napi"],
      "options": {
        "command": "pnpm run test:coverage"
      }
    },
    "test:rust": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:rust-coverage"
      }
    },
    "test:browser": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:browser"
      }
    },
    "test:native-parity": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:napi"],
      "options": {
        "command": "vitest run --config vitest.native.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:napi"],
      "options": {
        "command": "pnpm run typecheck"
      }
    },
    "validate-pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm run validate-pack"
      }
    },
    "check:size": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm run check:size"
      }
    },
    "check:dead-code": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run check:dead-code"
      }
    },
    "docs": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm run docs:build && pnpm run docs:test"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run format:check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:napi"],
      "options": {
        "command": "pnpm run lint"
      }
    },
    "prose": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run prose"
      }
    },
    "workflows": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run workflows"
      }
    },
    "docs-prose": {
      "executor": "nx:noop",
      "dependsOn": ["check:dead-code", "docs", "format", "lint", "prose", "workflows"]
    },
    "quality": {
      "executor": "nx:noop",
      "dependsOn": [
        "build",
        "check:dead-code",
        "check:size",
        "docs",
        "format",
        "lint",
        "prose",
        "test",
        "typecheck",
        "validate-pack",
        "workflows"
      ]
    }
  }
}
