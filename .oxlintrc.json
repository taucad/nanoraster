{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "coverage/**",
    "dist/**",
    "docs-site/.next/**",
    "docs-site/.source/**",
    "docs-site/public/demo/render_wasm.js",
    "rust/target/**",
    "src/native/**",
    "src/wasm/**"
  ],
  "plugins": ["typescript", "unicorn"],
  "overrides": [
    {
      "files": ["tests/**/*.mjs"],
      "rules": { "typescript/no-floating-promises": "off" }
    }
  ]
}
