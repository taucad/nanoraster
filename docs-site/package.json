{
  "name": "nanoraster-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/ensure-dist.mjs && node scripts/measure-sizes.mjs && next build && node scripts/emit-mdx-aliases.mjs && VERIFY_STATIC_OUTPUT=true vitest run api-coverage.test.ts sizes.test.ts",
    "dev": "next dev",
    "predev": "node scripts/ensure-dist.mjs && node scripts/measure-sizes.mjs",
    "generate:source": "node scripts/ensure-dist.mjs && fumadocs-mdx",
    "lint": "eslint .",
    "test": "node scripts/ensure-dist.mjs && vitest run",
    "typecheck": "node scripts/ensure-dist.mjs && fumadocs-mdx && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-typescript": "5.6.0",
    "fumadocs-ui": "16.17.9",
    "mermaid": "12.2.0",
    "nanoraster": "workspace:*",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
