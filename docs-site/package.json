{
  "name": "nanoraster-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "if [ ! -f ../dist/index.d.mts ]; then pnpm --dir .. exec tsdown; fi && next build",
    "dev": "next dev",
    "generate:source": "fumadocs-mdx",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "fumadocs-mdx && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.10.4",
    "fumadocs-mdx": "14.3.2",
    "fumadocs-typescript": "5.2.6",
    "fumadocs-ui": "16.10.4",
    "nanoraster": "workspace:*",
    "next": "16.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@types/three": "0.185.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
