{
  "name": "nanoraster-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "if [ ! -f ../dist/index.d.mts ]; then pnpm --dir .. exec tsdown; fi && node scripts/measure-sizes.mjs && next build && node scripts/emit-mdx-aliases.mjs && VERIFY_STATIC_OUTPUT=true vitest run api-coverage.test.ts sizes.test.ts",
    "dev": "next dev",
    "predev": "node scripts/measure-sizes.mjs",
    "generate:source": "fumadocs-mdx",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "fumadocs-mdx && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-typescript": "5.3.0",
    "fumadocs-ui": "16.15.4",
    "mermaid": "11.17.2",
    "nanoraster": "workspace:*",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
