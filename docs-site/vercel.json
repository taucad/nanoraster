{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/docs/:path*.mdx",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/docs.mdx",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ],
  "redirects": [
    { "source": "/docs/md/index", "destination": "/docs.mdx", "permanent": true },
    { "source": "/docs/md/:path*", "destination": "/docs/:path*.mdx", "permanent": true }
  ]
}
