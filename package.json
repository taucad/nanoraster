{
  "name": "nanoraster",
  "version": "0.4.1",
  "description": "Tiny headless WebGPU glTF renderer for deterministic PNG, WebP, JPEG, and raw RGBA output.",
  "keywords": [
    "gltf",
    "renderer",
    "thumbnail",
    "wasm",
    "webgpu"
  ],
  "homepage": "https://nanoraster.xyz",
  "bugs": {
    "url": "https://github.com/taucad/nanoraster/issues"
  },
  "license": "Apache-2.0",
  "author": "Richard Fontein",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/nanoraster.git"
  },
  "files": [
    "dist",
    "README.md",
    "compatibility.md",
    "CHANGELOG.md",
    "BREAKING_CHANGES.md",
    "NOTICE",
    "license"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "node": "./dist/index.node.mjs",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/cjs-error.d.cts",
        "default": "./dist/cjs-error.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./wasm": {
      "default": "./dist/wasm/render_wasm_bg.wasm"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "benchmark": "node bench/gated.mjs",
    "build": "pnpm run build:napi && pnpm run build:wasm && tsdown && node scripts/copy-assets.mjs",
    "build:napi": "pnpm exec napi build --platform --release --esm --js index.js --dts index.d.ts --manifest-path rust/render-napi/Cargo.toml --output-dir src/native -- --locked",
    "build:napi:bench": "pnpm exec napi build --platform --release --esm --js index.js --dts index.d.ts --manifest-path rust/render-napi/Cargo.toml --features bench --output-dir tests/out/native-bench -- --locked",
    "build:wasm": "node scripts/build-wasm.mjs && node scripts/clean-wasm-output.mjs",
    "build:wasm:bench": "node scripts/build-wasm.mjs --bench && node scripts/clean-wasm-output.mjs --bench",
    "check:dead-code": "pnpm run docs:source && knip",
    "check:wasm-size": "node scripts/check-wasm-size.mjs",
    "check:size": "size-limit && pnpm run check:wasm-size",
    "docs:build": "pnpm --filter nanoraster-docs build",
    "docs:links": "node scripts/check-links.mjs",
    "docs:routes": "node docs-site/scripts/test-built-routes.mjs",
    "docs:source": "pnpm --filter nanoraster-docs generate:source",
    "docs:test": "pnpm --filter nanoraster-docs test",
    "format:check": "oxfmt --check .",
    "lint": "pnpm run docs:source && oxlint --deny-warnings --type-aware && eslint .",
    "plan:check": "nx release plan:check",
    "pkgcheck": "pnpm run validate-pack && publint && attw --pack . --profile esm-only --entrypoints .",
    "prose": "./scripts/check-prose.sh",
    "test": "vitest run",
    "test:browser": "pnpm run build && pnpm run build:wasm:bench && vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:native-parity": "pnpm run build:napi && vitest run --config vitest.native.config.ts",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml --workspace --all-features",
    "test:rust-coverage": "bash ./scripts/test-rust-coverage.sh",
    "test:package": "node scripts/test-package.mjs",
    "typecheck": "tsc --noEmit",
    "validate-pack": "node scripts/validate-pack.mjs",
    "workflows": "./scripts/check-workflows.sh",
    "prepublishOnly": "node scripts/validate-pack.mjs",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "9.32.0",
    "@napi-rs/cli": "3.8.6",
    "@nx/js": "23.1.1",
    "@size-limit/file": "13.0.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.3",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "binaryen": "132.0.0",
    "eslint": "9.32.0",
    "globals": "17.11.0",
    "knip": "6.17.1",
    "nx": "23.1.1",
    "oxfmt": "0.36.0",
    "oxlint": "1.70.0",
    "oxlint-tsgolint": "0.22.1",
    "playwright": "1.62.0",
    "publint": "0.3.23",
    "semver": "7.8.5",
    "size-limit": "13.0.3",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.1",
    "vitest": "4.1.10"
  },
  "napi": {
    "binaryName": "nanoraster",
    "packageName": "nanoraster",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "i686-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "armv7-unknown-linux-gnueabihf",
      "powerpc64le-unknown-linux-gnu",
      "s390x-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "armv7-unknown-linux-musleabihf",
      "aarch64-linux-android",
      "armv7-linux-androideabi",
      "x86_64-unknown-freebsd"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.7.0"
}
